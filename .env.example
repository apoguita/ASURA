# Copy to .env and fill in. .env is gitignored; this file is not.
ASURA_DATABASE_URL=postgres://asura:<password>@127.0.0.1:5432/asura
ASURA_DB_ROLE=asura
ASURA_DB_PASSWORD=<password>
ASURA_DB_NAME=asura
ASURA_DB_HOST=127.0.0.1
ASURA_DB_PORT=5432

# Where the auth service listens. The reference binds 6112. Optional: --bind overrides it.
ASURA_AUTH_BIND=127.0.0.1:6112

# Set to 1 to log every message the auth service sends and receives (direction, header, name, size,
# first bytes). This is the only way to see what differs when the client says 007, so turn it on for
# any session with the real game client.
# ASURA_TRACE=1
